            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 85,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 8,
            "spanNulls": false,
            "axisSoftMin": 0,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "lineInterpolation": "linear",
            "axisBorderShow": false,
            "axisCenteredZero": false
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "interval": "1d"
