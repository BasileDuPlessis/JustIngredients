          "expr": "sum(increase(ji_gemini_cost_micro_usd_total{app=\"$app\"}[1d])) / 1e6",
          "legendFormat": "coût",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
