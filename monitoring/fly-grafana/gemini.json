              "mode": "normal",
              "group": "A"
            },
            "lineInterpolation": "linear",
            "axisBorderShow": false,
            "axisCenteredZero": false
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "entrée"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "entrée"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sortie"
