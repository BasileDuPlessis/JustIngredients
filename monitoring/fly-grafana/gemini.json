    {
      "id": 7,
      "type": "timeseries",
      "title": "Tokens par jour",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(ji_gemini_tokens_total{app=\"$app\",kind=\"input\"}[1d]))",
          "legendFormat": "entrée",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(ji_gemini_tokens_total{app=\"$app\",kind=\"output\"}[1d]))",
          "legendFormat": "sortie",
          "range": true,
          "instant": false
