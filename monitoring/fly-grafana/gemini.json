    {
      "id": 8,
      "type": "timeseries",
      "title": "Durée d'une lecture de photo",
      "description": "Nouvelles tentatives comprises, par jour.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (increase(ji_gemini_duration_seconds_bucket{app=\"$app\"}[1d])))",
          "legendFormat": "médiane",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(ji_gemini_duration_seconds_bucket{app=\"$app\"}[1d])))",
          "legendFormat": "95 %",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "always",
            "pointSize": 8,
            "spanNulls": false,
            "axisSoftMin": 0,
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "lineInterpolation": "linear",
            "axisBorderShow": false,
            "axisCenteredZero": false
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "médiane"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "médiane"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "95 %"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "95 %"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
