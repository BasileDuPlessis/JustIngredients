# Environment variables for JustIngredients Telegram Bot

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Your Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# PostgreSQL database connection string
DATABASE_URL=postgresql://username:password@localhost/ingredients

# =============================================================================
# OPTIONAL - HEALTH & METRICS
# =============================================================================

# Port of the public health checks, /health/live and /health/ready (default: 8080)
HEALTH_PORT=8080

# Port of the internal metrics server, /metrics, read by Fly (`[metrics]` in deploy/fly.toml;
# default: 9091). Not public, no token.
METRICS_PORT=9091

# Bind both servers to all interfaces (needed on Fly; default: localhost only)
METRICS_BIND_ALL_INTERFACES=false

# =============================================================================
# OPTIONAL - DATABASE CONFIGURATION
# =============================================================================

# Maximum database connections (default: 10, max: 100)
DATABASE_MAX_CONNECTIONS=5
# Minimum database connections kept open
DATABASE_MIN_CONNECTIONS=1

# Database connection timeout in seconds (default: 30, max: 300)
DATABASE_CONNECT_TIMEOUT_SECS=30

# =============================================================================
# OPTIONAL - HTTP CLIENT
# =============================================================================

# Timeout of the Telegram client, in seconds (default: 30, from 1 to 300)
HTTP_CLIENT_TIMEOUT_SECS=30

# How long a delivered message is remembered, to drop a duplicate delivery, in seconds
# (default: 300)
REQUEST_DEDUPLICATION_TTL_SECS=300

# =============================================================================
# OPTIONAL - SECURITY
# =============================================================================

# Allow binding to privileged ports (< 1024) (default: false)
ALLOW_PRIVILEGED_PORTS=false

# =============================================================================
# OPTIONAL - OBSERVABILITY & LOGGING
# =============================================================================

# Log lines: JSON (default, as on Fly) or "pretty" for readable local runs
LOG_FORMAT=pretty

# Log filter (default: "info,sqlx=warn,teloxide=warn")
RUST_LOG=info,sqlx=warn

# The owner's Telegram id (their private chat with the bot): alerts, the weekly report and
# /stats go there. Unset: no alerts nor report, /stats answers like an unknown command.
OWNER_CHAT_ID=

# Telegram ids allowed to create API tokens with /cle during the beta, separated by commas
# (specs/tasks/engine-api.md). Unset: nobody, /cle answers like an unknown command.
API_BETA_USERS=

# Ingredient extraction with Gemini (see specs/llm-extraction.md)
# Gemini API key from https://aistudio.google.com/apikey (paid tier), required. Never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Time budget for one image, retries included
GEMINI_TIMEOUT_SECS=40
GEMINI_THINKING_LEVEL=minimal
GEMINI_MAX_CONCURRENCY=2
# Photos read per user and UTC day, 1-10000 (default 50)
# EXTRACTION_DAILY_LIMIT_PER_USER=50
